# .gitignore — berkas yang tidak boleh masuk repo.
# Alasan: rahasia (.env berisi kunci API), data peserta (database), PDF berhak cipta (uploads),
# dan berkas hasil build/instalasi yang bisa dibuat ulang.
node_modules/
dist/
.env
.env.*
!.env.example
# Database & unggahan
data/
uploads/
# PDF buku berhak cipta tidak boleh masuk repo publik, di folder mana pun UPLOAD_DIR diarahkan.
*.pdf
*.db
*.db-wal
*.db-shm
.claude/settings.local.json
