# Contoh konfigurasi. Salin menjadi .env di akar proyek lalu sesuaikan:
#   Copy-Item .env.example .env
# Berkas .env TIDAK masuk git (kunci API AI nanti juga disimpan di sana).
# .env selalu dibaca dari akar proyek, dari folder mana pun perintah dijalankan.
#
# Mode TIDAK diatur di sini: `npm run dev` = development (hot reload),
# `npm start` = production (menyajikan dist/). Jadi .env yang hilang tidak membuat
# server tak sengaja berjalan dalam mode development.

# Port & alamat server. 127.0.0.1 = hanya bisa diakses dari komputer ini.
# Di VPS tetap 127.0.0.1 karena yang menerima koneksi dari luar adalah nginx (reverse proxy).
PORT=8132
HOST=127.0.0.1

# Lokasi berkas database SQLite, relatif terhadap akar proyek (folder dibuat otomatis).
DB_PATH=data/ujian.db

# Folder berkas PDF buku yang diunggah guru, relatif terhadap akar proyek (dibuat otomatis).
# Ikut dicadangkan bersama database. Tidak masuk git.
UPLOAD_DIR=uploads

# Isi true di VPS (di belakang reverse proxy nginx aaPanel) agar alamat IP & HTTPS terbaca benar.
# Biarkan false di laptop, supaya header X-Forwarded-For palsu tidak dipercaya.
TRUST_PROXY=false

# Alamat publik aplikasi PERSIS seperti di bilah alamat browser, tanpa garis miring di akhir.
# Wajib di VPS (npm start menolak jalan bila kosong), mis. https://ujian.domain-anda.id
# Dipakai untuk menolak permintaan dari situs lain (CSRF) dan memasang cookie khusus HTTPS.
# Di laptop dengan npm run dev boleh dikosongkan. Untuk mencoba npm start di laptop:
# ORIGIN_PUBLIK=http://127.0.0.1:8132
# lalu buka PERSIS alamat itu di browser (http://localhost:8132 akan ditolak karena berbeda).
ORIGIN_PUBLIK=

# ---- Penilaian AI (draf nilai dengan Claude) ----
# Kunci API dari Claude Console: https://platform.claude.com/settings/keys (sebaiknya dari workspace khusus "Ujian"
# yang diberi batas biaya bulanan di https://platform.claude.com/settings/spend-limits).
# Kosong = AI nonaktif; penilaian manual tetap bisa dipakai. Kunci HANYA ditulis di .env server: jangan dikirim lewat
# chat, jangan di-commit, jangan ditempel di tempat lain. Setelah mengubahnya, restart server (pm2 restart ujian).
ANTHROPIC_API_KEY=

# Model yang terpilih lebih dulu di halaman Penilaian (guru tetap bisa memilih yang lain di sana):
#   claude-haiku-5-5  = murah & cepat, untuk percobaan
#   claude-sonnet-5-5 = lebih teliti, untuk ujian sungguhan
AI_MODEL_BAWAAN=claude-haiku-5-5

# Batas biaya AI per bulan kalender (UTC) dalam USD, dihitung aplikasi dari pemakaian token. Bila permintaan
# berikutnya bisa melewati batas, AI berhenti sendiri dan sisanya dinilai manual. Ini lapis ketiga, setelah saldo
# prabayar (auto-reload biarkan mati) dan batas bulanan di Console.
AI_BATAS_USD_BULANAN=3

# Jumlah jawaban yang dinilai bersamaan (1–8). Akun baru punya batas laju rendah; 3 sudah cukup cepat.
AI_PARALEL=3

# Kedalaman berpikir model: low (paling murah & cepat), medium, high. Naikkan bila hasil pilot kurang teliti.
AI_EFFORT=low
